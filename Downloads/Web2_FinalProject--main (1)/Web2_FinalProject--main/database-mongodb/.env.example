# Cấu hình kết nối MongoDB (chọn 1 trong 2):
# 1. Kết nối MongoDB Cloud Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.vshnczr.mongodb.net/?retryWrites=true&w=majority
# 2. Kết nối MongoDB Local (trên máy cá nhân localhost:27017):
# MONGODB_URI=mongodb://localhost:27017

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.vshnczr.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=EcoCycleDatabase
PORT=3000
JWT_SECRET=your_jwt_secret_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
